local function newCard(order, height)
    local card = Instance.new("Frame")
    card.Size                   = UDim2.new(1, -8, 0, height or 54)
    card.BackgroundColor3       = C.card
    card.BackgroundTransparency = 0.05
    card.BorderSizePixel        = 0
    card.LayoutOrder            = order
    card.Parent                 = body
    Instance.new("UICorner", card).CornerRadius = UDim.new(0, 10)
    local stroke = Instance.new("UIStroke")
    stroke.Color        = C.stroke
    stroke.Thickness    = 1
    stroke.Transparency = 0.65
    stroke.Parent       = card
    local bar = Instance.new("Frame")
    bar.Size             = UDim2.new(0, 3, 1, -16)
    bar.Position         = UDim2.new(0, 0, 0, 8)
    bar.BackgroundColor3 = C.accent
    bar.BorderSizePixel  = 0
    bar.Parent           = card
    Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)
    return card
end

local function newLabel(parent, text, x, y, w, h, size, dim, bold)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.Position       = UDim2.new(0, x, 0, y)
    l.Size           = UDim2.new(0, w, 0, h or 18)
    l.Font           = bold and Enum.Font.GothamBold or Enum.Font.GothamMedium
    l.TextSize       = size or 14
    l.TextColor3     = dim and C.dim or C.text
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.Text           = text
    l.Parent         = parent
    return l
end

local function makeToggle(card, onChanged, initial)
    local isOn = initial or false
    local pill = Instance.new("TextButton")
    pill.Size             = UDim2.new(0, 50, 0, 26)
    pill.Position         = UDim2.new(1, -60, 0.5, -13)
    pill.BackgroundColor3 = isOn and C.on or C.off
    pill.Text             = ""
    pill.AutoButtonColor  = false
    pill.Parent           = card
    Instance.new("UICorner", pill).CornerRadius = UDim.new(1, 0)

    local knob = Instance.new("Frame")
    knob.Size             = UDim2.new(0, 20, 0, 20)
    knob.Position         = UDim2.new(0, isOn and 26 or 3, 0.5, -10)
    knob.BackgroundColor3 = Color3.fromRGB(248, 240, 255)
    knob.BorderSizePixel  = 0
    knob.Parent           = pill
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local function set(state)
        isOn = state
        TweenService:Create(pill, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {
            BackgroundColor3 = state and C.on or C.off
        }):Play()
        TweenService:Create(knob, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {
            Position = UDim2.new(0, state and 26 or 3, 0.5, -10)
        }):Play()
        if onChanged then pcall(onChanged, state) end
    end
    pill.MouseButton1Click:Connect(function() set(not isOn) end)
    return set
end

local function sectionHeader(order, text)
    local h = Instance.new("TextLabel")
    h.Size                   = UDim2.new(1, -8, 0, 20)
    h.BackgroundTransparency = 1
    h.Text                   = text
    h.Font                   = Enum.Font.GothamBold
    h.TextSize               = 11
    h.TextColor3             = C.accent
    h.TextXAlignment         = Enum.TextXAlignment.Left
    h.LayoutOrder            = order
    h.Parent                 = body
    return h
end

local function toggleCard(order, titleText, desc, flag, onChanged)
    local card = newCard(order, 54)
    newLabel(card, titleText, 16, 9, 320, 18, 14, false, true)
    newLabel(card, desc, 16, 29, 320, 16, 11, true, false)
    makeToggle(card, function(s)
        ASTA[flag] = s
        if onChanged then pcall(onChanged, s) end
    end, ASTA[flag])
    return card
end

sectionHeader(1, "FARM")
toggleCard(2, "Start Halloween Farm",           "Auto-farm the halloween event",   "HalloweenFarm")
toggleCard(3, "Auto Hold God Rock After Death", "Keeps god rock held on respawn",  "GodRockOnDeath")
toggleCard(4, "Auto Heal Bloodfruit",           "Uses bloodfruit to heal you",     "AutoHealBlood")
toggleCard(5, "Auto Use God Rock",              "Uses god rock automatically",     "GodRockUse")

sectionHeader(6, "COMBAT")

local kaCard = newCard(7, 96)
newLabel(kaCard, "Kill Aura", 16, 9, 240, 18, 14, false, true)
local kaValue = newLabel(kaCard, "Reach: " .. ASTA.KillAuraReach, 16, 30, 240, 14, 11, true, false)
makeToggle(kaCard, function(s) ASTA.KillAura = s end, ASTA.KillAura)

local reachBarBg = Instance.new("Frame")
reachBarBg.Size             = UDim2.new(1, -32, 0, 8)
reachBarBg.Position         = UDim2.new(0, 16, 1, -26)
reachBarBg.BackgroundColor3 = Color3.fromRGB(50, 35, 76)
reachBarBg.BorderSizePixel  = 0
reachBarBg.Parent           = kaCard
Instance.new("UICorner", reachBarBg).CornerRadius = UDim.new(1, 0)

local reachFill = Instance.new("Frame")
reachFill.Size             = UDim2.new((ASTA.KillAuraReach-5)/55, 0, 1, 0)
reachFill.BackgroundColor3 = C.accent
reachFill.BorderSizePixel  = 0
reachFill.Parent           = reachBarBg
Instance.new("UICorner", reachFill).CornerRadius = UDim.new(1, 0)
local fillGrad = Instance.new("UIGradient")
fillGrad.Color = ColorSequence.new{
    ColorSequenceKeypoint.new(0, C.accent2),
    ColorSequenceKeypoint.new(1, C.accent),
}
fillGrad.Parent = reachFill

local reachKnob = Instance.new("Frame")
reachKnob.Size             = UDim2.new(0, 14, 0, 14)
reachKnob.Position         = UDim2.new((ASTA.KillAuraReach-5)/55, -7, 0.5, -7)
reachKnob.BackgroundColor3 = Color3.fromRGB(255, 230, 255)
reachKnob.BorderSizePixel  = 0
reachKnob.ZIndex           = 3
reachKnob.Parent           = reachBarBg
Instance.new("UICorner", reachKnob).CornerRadius = UDim.new(1, 0)

local draggingReach = false
local MIN_R, MAX_R = 5, 60
local function setReachFromX(px)
    local barW = reachBarBg.AbsoluteSize.X
    if barW <= 0 then return end
    local t = math.clamp((px - reachBarBg.AbsolutePosition.X) / barW, 0, 1)
    local value = math.floor(MIN_R + t * (MAX_R - MIN_R) + 0.5)
    ASTA.KillAuraReach = value
    kaValue.Text = "Reach: " .. value
    reachFill.Size     = UDim2.new(t, 0, 1, 0)
    reachKnob.Position = UDim2.new(t, -7, 0.5, -7)
end
reachBarBg.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        draggingReach = true; setReachFromX(input.Position.X)
    end
end)
UIS.InputChanged:Connect(function(input)
    if draggingReach and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        setReachFromX(input.Position.X)
    end
end)
UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        draggingReach = false
    end
end)

sectionHeader(8, "SHOP")
toggleCard(9, "Auto Buy Gold Bundle", "Fire the gold bundle buyer loop", "GoldBundle", function(s)
    setGoldBundle(s)
end)

TweenService:Create(mainStroke,
    TweenInfo.new(1.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
    {Transparency = 0.55, Thickness = 3}):Play()

task.spawn(function()
    while gui.Parent do bgGrad.Rotation = (bgGrad.Rotation + 0.5) % 360; task.wait(0.03) end
end)
task.spawn(function()
    while gui.Parent do titleGrad.Rotation = (titleGrad.Rotation + 1.5) % 360; task.wait(0.03) end
end)
task.spawn(function()
    while gui.Parent do topGlowGrad.Rotation = (topGlowGrad.Rotation + 2) % 360; task.wait(0.03) end
end)
task.spawn(function()
    while gui.Parent do
        TweenService:Create(statusDot, TweenInfo.new(0.7), {BackgroundTransparency = 0.6}):Play()
        task.wait(0.7)
        if not gui.Parent then break end
        TweenService:Create(statusDot, TweenInfo.new(0.7), {BackgroundTransparency = 0}):Play()
        task.wait(0.7)
    end
end)

local dragging, dragStart, startPos
main.InputBegan:Connect(function(input)
    if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch)
        and input.Position.Y - main.AbsolutePosition.Y <= 72 then
        dragging = true; dragStart = input.Position; startPos = main.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)
main.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local d = input.Position - dragStart
        main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X,
                                   startPos.Y.Scale, startPos.Y.Offset + d.Y)
    end
end)

local collapsed = false
collapse.MouseButton1Click:Connect(function()
    collapsed = not collapsed
    if collapsed then
        body.Visible = false
        TweenService:Create(main, TweenInfo.new(0.2), {Size = UDim2.new(0, 460, 0, 76)}):Play()
        collapse.Text = "+"
    else
        body.Visible = true
        TweenService:Create(main, TweenInfo.new(0.2), {Size = UDim2.new(0, 460, 0, 560)}):Play()
        collapse.Text = "–"
    end
end)

closeBtn.MouseButton1Click:Connect(function() gui:Destroy() end)

gui.Destroying:Connect(function()
    INSTANCE.Dead = true
    ASTA.GoldBundle = false
end)

print("[AsterHub] Loaded successfully.")
